{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/ads-ops/ads_ops.py\" hook-snapshot",
            "timeout": 10,
            "statusMessage": "Saving a version of the file..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/ads-ops/ads_ops.py\" due --quiet",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
